[Unit]
Description=Card Scout private research worker
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=cardscout
Group=cardscout
Environment=HOME=/var/lib/cardscout
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/opt/cardscout/service
ExecStart=/usr/bin/python3 /opt/cardscout/service/linux.py serve
Restart=always
RestartSec=30
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cardscout

[Install]
WantedBy=multi-user.target
